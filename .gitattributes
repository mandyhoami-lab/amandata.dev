# Shell scripts and workflows must keep LF endings — CRLF breaks them on the
# Linux Actions runner. This repo is edited on Windows, where core.autocrlf
# would otherwise decide, so pin it here instead of relying on local config.
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# index.html: keep byte-exact. It began as generated output, and a --check
# re-pull still diffs it against a fresh minified fetch, so no eol conversion.
# It is NOT marked linguist-generated anymore -- that collapsed it by default in
# diffs and pull requests, which is precisely the review we now want to see.
index.html    -text
assets/**     binary

# upstream/index.html is the last-seen sanitized upstream HTML, kept only so
# --check has something honest to diff against. Byte-exact for the same reason,
# and still linguist-generated -- it really is generated, and nobody reviews it.
upstream/**   -text linguist-generated
